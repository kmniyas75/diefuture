{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/rooms",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rooms.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/rooms/:id",
      "destination": "/api/rooms?id=:id"
    },
    {
      "source": "/api/leads/:id",
      "destination": "/api/leads?id=:id"
    },
    {
      "source": "/room",
      "destination": "/room.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/shipping-policy",
      "destination": "/shipping-policy.html"
    }
  ]
}
